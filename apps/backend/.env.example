PORT=5000
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Analyses allowed to run at once; extra uploads get HTTP 429.
MAX_CONCURRENT_JOBS=2

# Prompt size cap. Files are ranked by importance and added until it is reached.
MAX_PROMPT_TOKENS=150000

# Write full prompts/responses (contain uploaded source code) to the log folder.
# Useful locally; keep false in production.
SAVE_DEBUG_ARTIFACTS=false
