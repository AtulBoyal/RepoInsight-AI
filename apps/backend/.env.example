PORT=5000
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Analyses allowed to run at once; extra uploads get HTTP 429.
MAX_CONCURRENT_JOBS=2

# Optional GitHub token for analyzing repositories by URL.
# Without it, GitHub allows 60 API requests/hour from the server's IP; with it, 5,000.
# A fine-grained token with no extra permissions is enough (public repos only).
# GITHUB_TOKEN=

# Rate limits on starting analyses (0 = no limit).
# Per visitor (IP address) per hour, and for the whole site per day.
RATE_LIMIT_PER_HOUR=5
RATE_LIMIT_PER_DAY=100

# Reverse proxies in front of the server (Render: 1; direct access: 0).
TRUST_PROXY_HOPS=1

# Prompt size cap. Files are ranked by importance and added until it is reached.
MAX_PROMPT_TOKENS=150000

# Optional sampling temperature (0-2). Lower = more consistent repeat reviews.
# GEMINI_TEMPERATURE=0.2

# Write full prompts/responses (contain uploaded source code) to the log folder.
# Useful locally; keep false in production.
SAVE_DEBUG_ARTIFACTS=false
